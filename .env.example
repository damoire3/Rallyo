# Rallyo — variables d'environnement (copier en .env.local, ne jamais commiter .env.local)

# Supabase : Project Settings > API
# Sans ces deux variables, la galerie « Ça se passe chez nous » affiche simplement les photos d'illustration,
# et seuls les ids de démo (c1, e1…) ouvrent une page de détail.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique du site (sitemap.xml, robots.txt). En production : https://ton-domaine.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Page Contact : coordonnées affichées sur /contact (laisser vide = canal masqué)
NEXT_PUBLIC_CONTACT_EMAIL=
# Numéro WhatsApp au format international, chiffres seulement (ex. 229XXXXXXXX)
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_PHONE=
# Ex. : Du lundi au vendredi, 9h-18h
NEXT_PUBLIC_CONTACT_HOURS=
